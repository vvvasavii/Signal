{
  "name": "signal",
  "version": "1.0.0",
  "description": "A reliability-focused incident response and alert orchestration platform",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "worker:dev": "tsx watch src/worker.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vvvasavii/Signal.git"
  },
  "keywords": [],
  "bugs": {
    "url": "https://github.com/vvvasavii/Signal/issues"
  },
  "homepage": "https://github.com/vvvasavii/Signal#readme",
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bullmq": "^6.3.14",
    "dotenv": "^18.0.6",
    "express": "^5.2.1",
    "ioredis": "^6.0.0",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "prisma": "^7.10.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
